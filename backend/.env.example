# ---------------------------------------------------------------------------
# Hikmah Online backend configuration. Copy to backend/.env and adjust.
# Values below are LOCAL DEVELOPMENT defaults. Production notes are inline.
# ---------------------------------------------------------------------------

# Core
DEBUG=True                                   # prod: False
SECRET_KEY=change-me-to-a-long-random-string # prod: 50+ random chars (python -c "import secrets;print(secrets.token_urlsafe(64))")
ALLOWED_HOSTS=localhost,127.0.0.1            # prod: api.<your-domain>
SITE_URL=http://localhost:3000               # prod: https://<your-web-domain>   (public web app)
API_URL=http://localhost:8000                # prod: https://<your-api-domain>   (Django: API + staff panel)
ADMIN_URL_PATH=staff-panel                   # prod: pick something non-obvious

# Database (docker compose exposes Postgres on 5433)
DATABASE_URL=postgres://hikmah:hikmah@localhost:5433/hikmah   # prod: injected by Railway

# Cookies / CORS / CSRF
SECURE_COOKIES=False                         # prod: True
SESSION_COOKIE_DOMAIN=                       # prod: .<your-root-domain> if web and api are on subdomains
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:8000
CORS_ALLOWED_ORIGINS=http://localhost:3000

# HTTPS (prod only)
SECURE_SSL_REDIRECT=False                    # prod: True
SECURE_HSTS_SECONDS=0                        # prod: 31536000
SECURE_HSTS_PRELOAD=False

# Staff security
STAFF_2FA_REQUIRED=False                     # prod: True (mandatory TOTP for admins/instructors)
STAFF_SESSION_TIMEOUT_MINUTES=60

# Login protection
LOGIN_MAX_ATTEMPTS=5
RATE_LIMIT_LOGIN=30/m/ip                      # sign-in requests per IP; the E2E suite needs more locally (e.g. 300/m/ip)
RATE_LIMIT_LOGIN_FAILED=10/m/ip,5/5m/key
LOCKOUT_MINUTES=15
PASSWORD_MIN_LENGTH=10
PWNED_PASSWORD_CHECK=False                   # prod: True (HaveIBeenPwned k-anonymity check)

# API throttling
THROTTLE_ANON=120/min
THROTTLE_USER=600/min
THROTTLE_VERIFY=20/min
THROTTLE_UPLOADS=20/hour
THROTTLE_EXPORT=5/hour

# Files
STORAGE_BACKEND=local                        # prod: s3 (Cloudflare R2)
MEDIA_ROOT=./media
SIGNED_URL_TTL_SECONDS=300
MAX_UPLOAD_MB=10
# S3_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com
# S3_BUCKET_PRIVATE=hikmah-private
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_REGION=auto

# Email (Mailpit in dev: UI at http://localhost:8025)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend   # prod: anymail.backends.resend.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=1025
DEFAULT_FROM_EMAIL=Hikmah Online <no-reply@hikmah.test>
# RESEND_API_KEY=

# Background worker (run: uv run python manage.py qcluster)
Q_SYNC=False                                 # True runs tasks inline (no worker needed)
Q_WORKERS=2

# Google sign-in (also switch on the "google_login" feature flag in the staff panel)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Optional
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
SENTRY_DSN=
BACKUP_RETENTION_DAYS=30
DEV_SEED_ALLOWED=True                        # prod: False (seed_dev refuses to run anyway when DEBUG=False)
